# Normalise to LF in the repository. Shell scripts and systemd units are run
# on Ubuntu after being checked out or copied from here; a CRLF line ending
# makes bash fail with an unreadable "\r: command not found".
* text=auto eol=lf

*.sh      text eol=lf
*.go      text eol=lf
*.mod     text eol=lf
*.work    text eol=lf
*.service text eol=lf
*.conf    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf

*.png binary
*.jpg binary
*.dll binary
*.exe binary
