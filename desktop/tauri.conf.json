{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LobbyBaz",
  "version": "0.1.0",
  "identifier": "ir.lobbybaz.desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "LobbyBaz",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/lobbyapp"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
