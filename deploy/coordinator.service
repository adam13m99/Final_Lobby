[Unit]
Description=Final Lobby coordinator (rooms, addressing, tickets)
Documentation=https://github.com/adam13m99/Final_Lobby
After=network-online.target
Wants=network-online.target
Before=relay.service

[Service]
Type=simple
User=finallobby
Group=finallobby

# Bound to all interfaces so both test PCs can reach it, and gated by a
# shared bearer token in front of the player API. Accounts are switched
# on (D60): -db gives it usernames, Argon2id passwords, sessions, durable
# MMR, the friend graph, moderation and last-seen times, and makes the
# session rather than the request body decide who a call is from (D53).
#
# -head-admin names the one account that can appoint and unappoint admins
# (D47). It is idempotent - a second start with the same account changes
# nothing - and it takes a username, because nobody has ever read an account
# id off a screen. It stays here rather than being run once by hand so that a
# rebuilt server comes back with its staff intact.
ExecStart=/opt/finallobby/coordinator \
    -listen 0.0.0.0:7001 \
    -relay-addr 87.107.110.199:443 \
    -relay-pub /etc/finallobby/relay.pub \
    -auth-token-file /etc/finallobby/api.token \
    -dist-dir /var/lib/finallobby/dist \
    -download-key-file /etc/finallobby/download.key \
    -db /var/lib/finallobby/db/lobby.db \
    -terms-file /etc/finallobby/terms-en.md \
    -head-admin arman13m99

Restart=always
RestartSec=2s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadOnlyPaths=/etc/finallobby
# The published installer lives here. ProtectSystem=strict makes everything
# read-only, and the coordinator only ever reads it - scripts/publish.sh is
# what writes, over SSH as root.
ReadOnlyPaths=/var/lib/finallobby
# The one thing it writes. SQLite needs the *directory* writable, not just
# the file: the write-ahead log and the shared-memory index are created
# beside it. Listed after ReadOnlyPaths on purpose - ReadWritePaths wins on
# a subpath, which is how the installer directory stays read-only while the
# database does not.
ReadWritePaths=/var/lib/finallobby/db

LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
