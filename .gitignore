# ─── Secrets — never commit ───
github_token_admin.txt
mobinhost_server_1.txt
*.token
*.pem
*.key
!release-pubkey.bin
.env
.env.*
!.env.example
secrets/

# ─── Build output ───
/target/
dist/
# Anchored, all of them. An unanchored "build/" also matches
# client/build/, which is a real Go package holding the values stamped in at
# link time - it was silently excluded until somebody noticed the app could
# not find its own server.
/build/
/out/
/artifacts/
/bin/
*.exe
*.dll
!wintun.dll

# ─── Dependencies ───
node_modules/
# NOTE: Go vendor/ directories are deliberately NOT ignored. goproxy.cn is the
# only reachable module proxy from here; vendored deps are what keep the build
# working if it goes away. See docs/decisions.md D11.
__pycache__/
*.pyc
.venv/
venv/

# ─── Go ───
*.test
*.out

# ─── Rust / Tauri ───
**/src-tauri/target/

# ─── Editor / OS ───
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ─── Logs / local state ───
*.log
logs/
tmp/

# Test bundle - contains the API token
/dist/

# The desktop shell's build output, and the Go binary copied in beside it.
# Both are produced by scripts/publish.sh from sources already tracked.
desktop/target/
desktop/binaries/
desktop/gen/
# ...but the shell's own splash page is source, not build output, and the
# unanchored `dist/` rule above would otherwise swallow it.
!desktop/dist/
!desktop/dist/**

# Screenshots from scripts/preview.sh: build output, not source.
scripts/shots/

# Go leaves this behind when a build is interrupted.
*.exe~
